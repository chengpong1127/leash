# Copy to .env — every app reads this one root file.
# These are local-demo values; generate fresh secrets for anything real.

LEASH_URL=http://localhost:3000
SHOP_URL=http://localhost:3001
JOBS_URL=http://localhost:3002

# Leash service (Better Auth)
BETTER_AUTH_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef
BETTER_AUTH_URL=http://localhost:3000

# Shop's credentials for calling Leash (the shop reads these as its LEASH_SITE_ID / LEASH_SITE_SECRET)
SHOP_LEASH_SITE_ID=site_shop
SHOP_LEASH_SITE_SECRET=dev-only-shop-secret-change-me

# Jobs' credentials for calling Leash
JOBS_LEASH_SITE_ID=site_jobs
JOBS_LEASH_SITE_SECRET=dev-only-jobs-secret-change-me
